{
  "backend": "perf",
  "project": {
    "dir": "/cephyr/users/wincenth/Vera/ra/gromacs/gromacs-2026.3",
    "build_system": "cmake",
    "target": "gmx",
    "executable": "bin/gmx",
    "cmake_flag_vars": ["CMAKE_CXX_FLAGS"],
    "cmake_defs": [
      "CMAKE_C_COMPILER=/usr/lib/llvm-18/bin/clang",
      "CMAKE_CXX_COMPILER=/usr/lib/llvm-18/bin/clang++",
      "GMX_GPU=OFF",
      "GMX_MPI=OFF",
      "GMX_BUILD_OWN_FFTW=ON",
      "REGRESSIONTEST_DOWNLOAD=ON",
      "BUILD_TESTING=OFF"
    ]
  },
  "compiler": "clang++",
  "runtime_cache_policy": "reuse",
  "compiler_flags_base": "",
  "compiler_flags": ["-O2", "-O3"],
  "compiler_flag_pool": [
    "-ffast-math",
    "-ffp-contract=fast",
    "-fno-math-errno",
    "-fno-trapping-math",
    "-freciprocal-math",
    "-fno-signed-zeros",
    "-fassociative-math",
    "-ffinite-math-only",
    "-fno-stack-protector",
    "-fcf-protection=none",
    "-flto=thin",
    "-mllvm -enable-loopinterchange"
  ],
  "flag_constraints": {
    "exclusive": [
      ["-fvectorize", "-fno-vectorize"],
      ["-fslp-vectorize", "-fno-slp-vectorize"],
      ["-funroll-loops", "-fno-unroll-loops"],
      ["-fstrict-aliasing", "-fno-strict-aliasing"],
      ["-fmerge-all-constants", "-fno-merge-all-constants"],
      ["-fdelete-null-pointer-checks", "-fno-delete-null-pointer-checks"],
      ["-fmath-errno", "-fno-math-errno"]
    ],
    "implies": {
      "-ffast-math": ["-fno-math-errno", "-ffp-contract=fast", "-fassociative-math",
                      "-freciprocal-math", "-fno-signed-zeros", "-fno-trapping-math",
                      "-ffinite-math-only"],
      "-O2": ["-fstrict-aliasing", "-fdelete-null-pointer-checks", "-fslp-vectorize",
              "-fvectorize", "-funroll-loops", "-fno-merge-all-constants", "-fmath-errno"],
      "-O3": ["-fstrict-aliasing", "-fdelete-null-pointer-checks", "-fslp-vectorize",
              "-fvectorize", "-funroll-loops", "-fno-merge-all-constants", "-fmath-errno"]
    }
  },
  "compiler_params": {
    "-mtune": ["znver4"],
    "-mprefer-vector-width": [128, 256, 512],
    "-mllvm -unroll-threshold": [150, 300, 600],
    "-mllvm -inline-threshold": [225, 500, 1000],
    "-mllvm -force-vector-interleave": [2, 4, 8, 16]
  },
  "compiler_params_select": {
    "min": 0,
    "max": 4,
    "always": []
  },
  "program_args": [
    "mdrun",
    "-s",
    "/cephyr/users/wincenth/Vera/ra/gromacs/SCOuT/runfiles/cubic.tpr",
    "-deffnm",
    "scout_cpu_omp",
    "-nsteps",
    "5000",
    "-resethway",
    "-noconfout",
    "-ntmpi",
    "1",
    "-ntomp",
    "32",
    "-pin",
    "on",
    "-nb",
    "cpu",
    "-pme",
    "cpu",
    "-update",
    "cpu",
    "-bonded",
    "cpu"
  ],
  "env": {
    
  },
  "objectives": [
    { "metric": "CPI", "goal": "min" }
  ],
  "search": {
    "study": "tabu",
    "random_seed": 13
  },
  "tabu": {
    "max_iters": 16,
    "max_no_improve": 5,
    "tabu_tenure": 8,
    "neighborhood": 4,
    "allow_variant_moves": true,
    "allow_param_moves": true,
    "allow_pool_moves": true,
    "allow_env_moves": true,
    "env_mode": "sample",
    "env_cap": 4,
    "results_csv": "./tabu_cpu_omp_perf.csv",
    "clean_run_outputs": true,
    "clean_globs": ["mdout.mdp"]
  },
  "perf": {
    "events": ["cycles", "instructions"],
    "core_list": "",
    "run_cwd": "binary_dir",
    "warmup_runs": 2,
    "objective": { "metric": "CPI", "goal": "min" }
  },
  "runs": 8,
  "csv_log": "./tabu_cpu_omp_perf_unused.csv",
  "failed_builds": "./tabu_cpu_omp_perf_failed.csv"
}
