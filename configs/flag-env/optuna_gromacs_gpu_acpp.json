{
  "backend": "parser",
  "project": {
    "dir": "/cephyr/users/wincenth/Vera/ra/gromacs/gromacs-2026.3",
    "build_system": "cmake",
    "target": "gmx",
    "executable": "bin/gmx",
    "build_jobs": 32,
    "cmake_flag_vars": ["CMAKE_CXX_FLAGS"],
    "cmake_defs": [
      "CMAKE_C_COMPILER=/usr/lib/llvm-18/bin/clang",
      "CMAKE_CXX_COMPILER=/usr/lib/llvm-18/bin/clang++",
      "GMX_SYCL=ACPP",
      "GMX_GPU=SYCL",
      "ACPP_TARGETS=cuda:sm_90",
      "GMX_BUILD_OWN_FFTW=ON",
      "REGRESSIONTEST_DOWNLOAD=ON",
      "BUILD_TESTING=OFF"
    ]
  },
  "compiler": "acpp",
  "runtime_cache_policy": "reuse",
  "compiler_flags_base": "",
  "compiler_flags": [
    "-O2",
    "-O3"
  ],
  "compiler_flag_pool": [
    "-fno-math-errno",
    "-ffp-contract=fast",
    "-ffast-math",
    "-funroll-loops",
    "-fno-unroll-loops",
    "-fstrict-aliasing",
    "-fno-strict-aliasing",
    "-mllvm -force-vector-interleave={2,4,8,16}",
    "-mllvm -enable-loopinterchange",
    "-fdelete-null-pointer-checks",
    "-fno-delete-null-pointer-checks",
    "-fexceptions",
    "-fno-exceptions",
    "-fno-rtti"
  ],
  "compiler_params": {
    "-march": ["native", "znver4"],
    "-mprefer-vector-width": [128, 256]
  },
  "compiler_params_select": {
    "min": 0,
    "max": 2,
    "always": []
  },
  "program_args": [
    "mdrun",
    "-s",
    "/cephyr/users/wincenth/Vera/ra/gromacs/SCOuT/runfiles/cubic.tpr",
    "-deffnm",
    "scout_gpu_acpp",
    "-nsteps",
    "2000",
    "-ntmpi",
    "1",
    "-ntomp",
    "8",
    "-pin",
    "on",
    "-nb",
    "gpu",
    "-pme",
    "gpu",
    "-update",
    "gpu",
    "-bonded",
    "gpu"
  ],
  "env": {},
  "objectives": [
    { "metric": "gmx_ns_per_day", "goal": "max" }
  ],
  "search": {
    "study": "optuna",
    "sampler": "tpe",
    "n_startup_trials": 8,
    "random_seed": 17
  },
  "parser": {
    "label": "sum",
    "aggregate": "sum",
    "run_cwd": "binary_dir",
    "warmup_runs": 2,
    "format": "gromacs"
  },
  "runs": 5,
  "csv_log": "./optuna_gromacs_gpu_acpp.csv",
  "failed_builds": "./optuna_gromacs_gpu_acpp_failed.csv"
}
